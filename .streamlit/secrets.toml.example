# Copia questo file in ".streamlit/secrets.toml" (che NON va caricato su GitHub, è già escluso da .gitignore)
# per usare Turso anche in locale, oppure imposta le stesse due chiavi nella sezione
# "Secrets" delle impostazioni dell'app su Streamlit Community Cloud.
#
# Se questi valori non sono presenti, l'app usa automaticamente un database SQLite
# locale (data/app.db) come fallback: comodo per provare l'app, ma i dati NON
# persistono tra un redeploy e l'altro su Streamlit Cloud.

TURSO_DATABASE_URL = "libsql://il-tuo-database-xxxx.turso.io"
TURSO_AUTH_TOKEN = "il-tuo-token-segreto"
